{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "src/generated/**"
  ],
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error",
    "no-console": "warn",
    "no-debugger": "error",
    "typescript/consistent-type-definitions": [
      "error",
      "interface"
    ]
  },
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": [
        "**/*.spec.ts",
        "**/*.e2e-spec.ts"
      ],
      "rules": {
        "typescript/unbound-method": "off"
      }
    }
  ]
}
