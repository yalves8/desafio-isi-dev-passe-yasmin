{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "ignorePatterns": [
    "src/components/ui/**",
    "dist/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "typescript/no-floating-promises": "error",
    "no-console": "warn",
    "no-debugger": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.tsx",
        "**/*.test.ts",
        "src/test/**"
      ],
      "rules": {
        "typescript/unbound-method": "off"
      }
    }
  ],
  "env": {
    "browser": true
  }
}
